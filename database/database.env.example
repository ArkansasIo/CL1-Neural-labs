# Cortical Labs CL1 System - Database Connection Parameters
# Copy to .env or inject in deployment environment

CL1_DB_DIALECT="mysql"
CL1_DB_HOST="127.0.0.1"
CL1_DB_PORT=3306
CL1_DB_USER="cl1_operator"
CL1_DB_PASSWORD="your_secure_cl1_mysql_password_here"
CL1_DB_NAME="cortical_labs_cl1"

# SSL/TLS Configuration for Cloud Hosted Instances
CL1_DB_SSL_ENABLED=false
CL1_DB_SSL_CA="/etc/ssl/certs/ca-certificates.crt"

# Dataset Export Directories
CL1_DATASET_DIR="./database/datasets"
CL1_HDF5_STORAGE_DIR="/data/recordings"
